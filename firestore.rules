rules_version = '2';

// Mindenki csak a saját fiókja alatti adatokat olvashatja és írhatja.
// Ezt a szöveget a Firebase konzolban kell beilleszteni: Firestore Database → Szabályok (Rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
